# Copy this file to .env (same folder) and fill in your own values. Never commit .env.
SARVAM_API_KEY=
# Signs the audit anchor. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
TATKAL_AUDIT_KEY=
# Only for a demo with no Sarvam key: lets the rule reader act alone (shown in red, logged)
# TATKAL_SINGLE_KEY_DEMO=1
# Optional overrides
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_LANG=hi-IN
# A second place for signed audit checkpoints, ideally another disk or a synced folder you do not edit
# TATKAL_ANCHOR_DIR=

# On by default: every new Tatkal message is voiced in the background so play is instant.
# This sends message text (customer names, amounts) to Sarvam before anyone presses play. Set 0 to turn off.
# TATKAL_TTS_PREFETCH=0
# Demo date for the RBI clock (scenarios are written for 2026-10-31)
# TATKAL_TODAY=2026-10-31
